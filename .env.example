# A voice name from `edge-tts --list-voices`
EDGE_VOICE=en-US-GuyNeural

# Spanish voice used when a reply is detected as Spanish
EDGE_VOICE_ES=es-GT-AndresNeural

# How confident (0-1) the language detector must be that a reply is Spanish before
# switching off the English voice; short/ambiguous English text can otherwise get
# misdetected as Spanish
SPANISH_CONFIDENCE_THRESHOLD=0.9

# Bluetooth keepalive: a case-insensitive substring of your earbuds' output-device name.
# After a reply, Marvis briefly streams silence to keep the BT link awake so the next reply's
# first word isn't clipped -- but ONLY when this device is the active output, so it never
# stresses your laptop speakers or a wired headset. Leave empty to disable keepalive entirely.
# (Run `python -c "import sounddevice as sd; print(sd.query_devices())"` with the earbuds
# connected to find the exact name.)
TTS_KEEPALIVE_DEVICE=

# How long (seconds) to keep the BT link warm after a reply before releasing the device.
TTS_KEEPALIVE_SECONDS=10
